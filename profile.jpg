<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ashton's Website 🚀</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#030511;color:white;overflow-x:hidden}
.background{position:fixed;inset:0;z-index:-5;overflow:hidden;background:radial-gradient(circle at 20% 20%,#350080 0%,transparent 30%),radial-gradient(circle at 80% 80%,#005eff 0%,transparent 30%),#030511}
.orb{position:absolute;width:350px;height:350px;border-radius:50%;filter:blur(90px);opacity:.35;animation:float 12s infinite ease-in-out}
.orb:nth-child(1){background:#8a00ff;top:5%;left:5%}
.orb:nth-child(2){background:#00c6ff;bottom:5%;right:5%;animation-delay:-4s}
.orb:nth-child(3){background:#0066ff;top:45%;left:45%;animation-delay:-8s}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(50px,-40px) scale(1.15)}}
.grid{position:fixed;inset:0;z-index:-4;opacity:.12;background-image:linear-gradient(rgba(0,198,255,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(0,198,255,.35) 1px,transparent 1px);background-size:50px 50px;mask-image:linear-gradient(to bottom,transparent,black 20%,black 80%,transparent)}
nav{position:fixed;top:0;left:0;width:100%;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:12px 7%;background:rgba(3,5,17,.65);backdrop-filter:blur(15px);border-bottom:1px solid rgba(255,255,255,.08)}
.logo-wrap{display:flex;align-items:center;gap:12px}
.profile-pic{width:46px;height:46px;object-fit:cover;border-radius:50%;border:2px solid #00c6ff;box-shadow:0 0 12px #00c6ff,0 0 28px rgba(0,114,255,.5)}
.logo{font-size:22px;font-weight:bold;color:#65ddff;text-shadow:0 0 10px #00c6ff,0 0 25px #0066ff}
.profile-button{padding:0;border:0;background:none;cursor:pointer;border-radius:50%}
.profile-button:focus-visible{outline:2px solid #65ddff;outline-offset:4px}
.photo-modal{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:30px;background:rgba(0,0,0,.82);backdrop-filter:blur(12px)}
.photo-modal.show{display:flex;animation:modalIn .25s ease}
.photo-modal img{max-width:min(90vw,700px);max-height:85vh;width:auto;height:auto;object-fit:contain;border-radius:22px;border:2px solid rgba(0,198,255,.8);box-shadow:0 0 30px #00c6ff,0 0 90px rgba(0,114,255,.45)}
.photo-close{position:absolute;top:24px;right:28px;width:46px;height:46px;border:1px solid rgba(255,255,255,.25);border-radius:50%;background:rgba(255,255,255,.1);color:white;font-size:28px;cursor:pointer}
.photo-close:hover{background:#00c6ff;color:#030511;box-shadow:0 0 20px #00c6ff}
@keyframes modalIn{from{opacity:0}.to{opacity:1}}
nav ul{display:flex;list-style:none;gap:30px}
nav a{color:#c9dcff;text-decoration:none;font-weight:bold;transition:.25s}
nav a:hover{color:#65ddff;text-shadow:0 0 10px #00c6ff}
section{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:100px 7%}
.content{width:100%;max-width:1100px;text-align:center}
.badge{display:inline-block;padding:8px 16px;margin-bottom:25px;border:1px solid rgba(0,198,255,.5);border-radius:999px;background:rgba(0,198,255,.08);color:#8deaff;font-size:13px;font-weight:bold;letter-spacing:1px;box-shadow:0 0 20px rgba(0,198,255,.15)}
.hero h1{font-size:clamp(50px,9vw,95px);line-height:1;background:linear-gradient(90deg,white,#65ddff,#8b7cff,white);background-size:300%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:gradient 6s ease infinite;text-shadow:0 0 40px rgba(0,198,255,.25)}
@keyframes gradient{0%{background-position:0%}50%{background-position:100%}100%{background-position:0%}}
.hero p{max-width:650px;margin:30px auto;color:#c9dcff;font-size:20px;line-height:1.7}
.typing{color:#00c6ff;font-weight:bold}
.buttons{display:flex;justify-content:center;gap:15px;flex-wrap:wrap;margin-top:35px}
.button{display:inline-block;padding:14px 25px;border:1px solid rgba(0,198,255,.7);border-radius:14px;background:rgba(0,198,255,.08);color:white;text-decoration:none;font-weight:bold;cursor:pointer;backdrop-filter:blur(10px);transition:.25s}
.button:hover{transform:translateY(-6px);background:rgba(0,198,255,.2);box-shadow:0 0 20px rgba(0,198,255,.5),0 0 50px rgba(0,114,255,.2)}
.section-title{font-size:50px;margin-bottom:20px;text-shadow:0 0 20px rgba(0,198,255,.5)}
.section-subtitle{color:#9fb3d8;margin-bottom:50px}
.about-box,.contact-box{max-width:750px;margin:auto;padding:40px;border-radius:25px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(15px);box-shadow:0 20px 60px rgba(0,0,0,.3)}
.about-box p{color:#c9dcff;line-height:1.8;margin:15px 0}
.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}
.project{padding:35px 25px;border-radius:22px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(12px);transition:.3s}
.project:hover{transform:translateY(-10px);border-color:rgba(0,198,255,.5);box-shadow:0 20px 60px rgba(0,198,255,.12)}
.project-icon{font-size:45px;margin-bottom:20px}
.project h3{margin-bottom:15px}
.project p{color:#9fb3d8;line-height:1.6}
.contact-box{max-width:650px;border-color:rgba(0,198,255,.25);box-shadow:0 0 50px rgba(0,198,255,.1)}
.contact-icon{font-size:55px;margin-bottom:20px}
.contact-box p{color:#b8cbed;margin:15px 0 25px}
.email{display:inline-block;padding:14px 20px;border-radius:12px;background:rgba(0,198,255,.08);border:1px solid rgba(0,198,255,.35);color:#65ddff;text-decoration:none;font-weight:bold;transition:.25s}
.email:hover{color:white;background:#00c6ff;box-shadow:0 0 25px #00c6ff}
footer{padding:30px;text-align:center;color:#647799;border-top:1px solid rgba(255,255,255,.08)}
@media(max-width:750px){nav{padding:10px 4%}.profile-pic{width:40px;height:40px}.logo{font-size:17px}nav ul{gap:12px}nav a{font-size:13px}section{padding:100px 5%}.projects{grid-template-columns:1fr}.section-title{font-size:40px}.hero p{font-size:17px}.email{font-size:14px}}
</style>
</head>
<body>
<div class="background"><div class="orb"></div><div class="orb"></div><div class="orb"></div></div>
<div class="grid"></div>

<div class="photo-modal" id="photoModal" onclick="closePhoto(event)">
    <button class="photo-close" onclick="closePhoto()" aria-label="Close picture">×</button>
    <img src="profile.jpg" alt="Profile picture enlarged">
</div>

<nav>
    <div class="logo-wrap">
        <button class="profile-button" onclick="openPhoto()" aria-label="Open profile picture"><img class="profile-pic" src="profile.jpg" alt="Profile picture"></button>
        <div class="logo">🚀 ASHTON</div>
    </div>
    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</nav>

<section id="home">
<div class="content hero">
    <div class="badge">✦ WELCOME TO MY WEBSITE ✦</div>
    <h1>Hey, I'm Ashton 👋</h1>
    <p>Welcome to my corner of the internet.<br><br><span class="typing" id="typing"></span></p>
    <div class="buttons">
        <a class="button" href="#about">👤 About Me</a>
        <a class="button" href="#projects">🚀 Projects</a>
        <a class="button" href="#contact">📧 Contact</a>
    </div>
</div>
</section>

<section id="about">
<div class="content">
    <h2 class="section-title">About Me 👋</h2>
    <p class="section-subtitle">A little bit about me</p>
    <div class="about-box">
        <p>Hi! I'm <strong>Ashton</strong>.</p>
        <p>I'm learning how to build websites using HTML, CSS, and JavaScript.</p>
        <p>I enjoy creating things, experimenting with code, and learning new stuff.</p>
        <p>This website is one of my projects! 🚀</p>
    </div>
</div>
</section>

<section id="projects">
<div class="content">
    <h2 class="section-title">My Projects 🚀</h2>
    <p class="section-subtitle">Things I'm working on</p>
    <div class="projects">
        <div class="project"><div class="project-icon">🌐</div><h3>My Website</h3><p>This website! A project built with HTML, CSS, and JavaScript.</p></div>
        <div class="project"><div class="project-icon">💻</div><h3>Coding</h3><p>I'm learning more about programming and building cool things.</p></div>
        <div class="project"><div class="project-icon">⚡</div><h3>Coming Soon</h3><p>More projects will appear here as I build them.</p></div>
    </div>
</div>
</section>

<section id="contact">
<div class="content">
    <h2 class="section-title">Contact Me 📧</h2>
    <p class="section-subtitle">Want to get in touch?</p>
    <div class="contact-box">
        <div class="contact-icon">✉️</div>
        <h2>Send Me An Email</h2>
        <p>Click the button below to contact me.</p>
        <a class="email" href="mailto:ashton.allen0420@outlook.com">ashton.allen0420@outlook.com</a>
    </div>
</div>
</section>

<footer>© 2026 Ashton • Built with HTML, CSS & JavaScript 🚀</footer>

<script>
const words=["Building cool things.","Learning to code.","Making websites.","Exploring JavaScript.","Creating something awesome."];
let wordIndex=0,letterIndex=0,deleting=false;
const typing=document.getElementById("typing");
function typeEffect(){
    const word=words[wordIndex];
    if(!deleting){
        typing.textContent=word.substring(0,letterIndex+1);
        letterIndex++;
        if(letterIndex===word.length){deleting=true;setTimeout(typeEffect,1400);return;}
    }else{
        typing.textContent=word.substring(0,letterIndex-1);
        letterIndex--;
        if(letterIndex===0){deleting=false;wordIndex=(wordIndex+1)%words.length;}
    }
    setTimeout(typeEffect,deleting?40:75);
}
typeEffect();

function openPhoto(){
    document.getElementById("photoModal").classList.add("show");
    document.body.style.overflow = "hidden";
}

function closePhoto(event){
    if(event && event.target.closest(".photo-modal img")) return;
    document.getElementById("photoModal").classList.remove("show");
    document.body.style.overflow = "";
}

document.addEventListener("keydown", function(event){
    if(event.key === "Escape") closePhoto();
});
</script>
</body>
</html>
